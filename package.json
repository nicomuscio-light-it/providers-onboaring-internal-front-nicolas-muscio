{
  "name": "sample",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && tsc",
    "serve": "vite preview",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write --cache \"${npm_package_config_prettier_glob}\"",
    "format:check": "prettier --check --cache \"${npm_package_config_prettier_glob}\"",
    "prepare": "husky",
    "type-check": "tsc --noEmit",
    "spell-check": "cspell . --no-progress --cache",
    "fixer": "pnpm lint:fix && pnpm format && pnpm type-check && pnpm spell-check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@iconify/react": "^6.0.2",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@t3-oss/env-core": "^0.13.8",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.4",
    "@tanstack/react-router": "^1.133.3",
    "@tanstack/react-router-devtools": "^1.133.3",
    "axios": "^1.12.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.80.0",
    "sonner": "^2.0.7",
    "string-ts": "^2.2.1",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "^4.1.14",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.12",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.37.0",
    "@storybook/addon-a11y": "^9.1.12",
    "@storybook/addon-docs": "^9.1.12",
    "@storybook/addon-onboarding": "^9.1.12",
    "@storybook/react-vite": "^9.1.12",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@tanstack/eslint-plugin-router": "^1.133.3",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/router-plugin": "^1.133.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.8.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "cspell": "^9.2.1",
    "eslint": "^9.37.0",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-prefer-arrow-functions": "^3.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^2.0.0",
    "eslint-plugin-storybook": "^9.1.12",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "storybook": "^9.1.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "vite-bundle-analyzer": "^1.2.3",
    "vitest": "^3.2.4",
    "web-vitals": "^5.1.0"
  },
  "packageManager": "pnpm@10.18.3"
}
